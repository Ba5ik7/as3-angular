<?xml version="1.0" encoding="utf-8"?>
<s:Group xmlns:fx="http://ns.adobe.com/mxml/2009"
         xmlns:s="library://ns.adobe.com/flex/spark"
         width="100%" height="100%">
  <fx:Script>
    <![CDATA[
      import app.viewmodels.CounterViewModel;
      [Bindable] public var viewModel:CounterViewModel;
    ]]>
  </fx:Script>

  <s:VGroup horizontalCenter="0" verticalCenter="0" gap="12">
    <s:Label text="MVVM Demo" fontSize="20"/>
    <s:Label text="Count: {viewModel.count}" fontSize="18"/>
    <s:HGroup gap="8">
      <s:Button label="Increment" enabled="{!viewModel.busy}" click="viewModel.increment()"/>
      <s:Button label="Reset" enabled="{!viewModel.busy}" click="viewModel.reset()"/>
    </s:HGroup>
    <s:Label text="{viewModel.busy ? 'Working...' : ''}"/>
  </s:VGroup>
</s:Group>
